##############################################################################
# PlacePulse AI — Production Environment
# ─────────────────────────────────────────────────────────────────────────────
# This file is committed as a REFERENCE TEMPLATE only.
# ✗ Do NOT store real secrets here.
# ✓ On Render: set secrets via the dashboard Environment panel.
# ✓ Locally: copy to .env and fill in values.
##############################################################################

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="PlacePulse AI"
APP_ENV=production
APP_KEY=                            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://app-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (SQLite on Render persistent disk) ───────────────────────────────
# The disk is mounted at /var/data via render.yaml — 1 GB free tier.
# Run migrations after first deploy: php artisan migrate --force
DB_CONNECTION=sqlite
DB_DATABASE=/var/data/database.sqlite

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis               # Upstash Redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ── Broadcasting / Filesystem / Queue ────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=redis                  # Upstash Redis

# ── Redis / Upstash ──────────────────────────────────────────────────────────
# Create a free database at https://console.upstash.com
# Copy the "Redis URL" (starts with rediss://) from the Upstash dashboard.
REDIS_CLIENT=predis
# Set UPSTASH_REDIS_URL to your Upstash Redis URL (starts with rediss://).
# config/database.php reads this directly — no need to also set REDIS_URL.
UPSTASH_REDIS_URL=rediss://default:YOURPASSWORD@YOUR-ENDPOINT.upstash.io:6379

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                    # Your OpenAI secret key
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=8000
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT=120

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
