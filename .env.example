APP_NAME="PlacePulse AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# Local: SQLite file | Production (Render): /var/data/database.sqlite (persistent disk)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=file

# ── Redis / Upstash ──────────────────────────────────────────────────────────
# Local dev: leave REDIS_* pointing to local Redis (or leave blank to use file/db drivers).
# Production: set REDIS_CLIENT=predis and REDIS_URL to your Upstash rediss:// URL.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_URL=

# Upstash — only needed in production; copy value from https://console.upstash.com
UPSTASH_REDIS_URL=

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=8000
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
